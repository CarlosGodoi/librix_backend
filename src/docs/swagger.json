{
  "openapi": "3.0.0",
  "info": {
    "title": "LibriX API",
    "description": "Sistema de gestão para Bibliotecas",
    "contact": { "email": "edu-godoi@hotmail.com" },
    "version": "1.0.0"
  },
  "servers": [{ "url": "http://localhost:3334", "description": "API desenvolvimento" }],
  "tags": [
    {
      "name": "Users",
      "description": "Gestão de usuários (registro, autenticação, consulta e remoção)"
    },
    {
      "name": "Books",
      "description": "Gestão de livros (registro, atualização, consulta e remoção)"
    },
    {
      "name": "Loans",
      "description": "Gestão de empréstimos de livros"
    }
  ],
  "paths": {
    "/register": {
      "post": {
        "summary": "Registrar novo usuário",
        "tags": ["Users"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Register" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário registrado com sucesso.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth": {
      "post": {
        "summary": "Autenticar usuário",
        "tags": ["Users"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Authenticate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário autenticado com sucesso.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/refresh": {
      "post": {
        "summary": "Renovar access token usando refresh token",
        "tags": ["Users"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshToken" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token renovado com sucesso.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccessToken" }
              }
            }
          },
          "400": {
            "description": "Refresh token não informado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Refresh token required." }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "User not found." }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "Buscar usuários",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de usuários",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/User" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/user/{id}": {
      "get": {
        "summary": "Buscar usuário por id",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id do usuário",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/user/update/{id}": {
      "put": {
        "summary": "Atualizar dados do usuário",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do usuário",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/user/delete/{id}": {
      "delete": {
        "summary": "Deletar usuário",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do usuário",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário deletado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Delete" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/book/register": {
      "post": {
        "summary": "Registrar novo livro",
        "tags": ["Books"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BookRegister" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário registrado com sucesso.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BookRegister" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/books": {
      "get": {
        "summary": "Buscar livros",
        "tags": ["Books"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de livros",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Book" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/book/{id}": {
      "get": {
        "summary": "Buscar livro por id",
        "tags": ["Books"],
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id do livro",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "livro encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Book" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/books/recommendations/{userId}": {
      "get": {
        "summary": "Buscar recomendações de livros para um usuário",
        "description": "Analisa o histórico de empréstimos recentes do usuário e retorna livros com temas/gêneros similares, usando embeddings semânticos e um modelo de linguagem para gerar a explicação.",
        "tags": ["Books"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "ID do usuário",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Recomendações geradas com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BookRecommendations" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/book/{id}/upload": {
      "post": {
        "summary": "Upload de imagem do livro",
        "tags": ["Books"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do livro",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Arquivo de imagem do livro (jpg, png, etc)"
                  }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload realizado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UploadImageBook" }
              }
            }
          },
          "400": {
            "description": "Arquivo não enviado ou formato inválido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Arquivo inválido ou não enviado" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Livro não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Livro não encontrado" }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Arquivo muito grande",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Arquivo excede o tamanho máximo permitido"
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/book/update/{id}": {
      "put": {
        "summary": "Atualizar dados do livro",
        "tags": ["Books"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do livro",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BookUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "livro atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Book" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/book/delete/{id}": {
      "delete": {
        "summary": "Deletar livro",
        "tags": ["Books"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do livro",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Livro deletado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeleteBook" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/loan/register": {
      "post": {
        "summary": "Registrar um empréstimo de livro",
        "tags": ["Loans"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoanRegister" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário registrado com sucesso.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoanRegister" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/loan/return/{id}": {
      "patch": {
        "summary": "Retorno de empréstimo de livro",
        "tags": ["Loans"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do empréstimo",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Empréstimo retornado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReturnedLoan" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/loans": {
      "get": {
        "summary": "Buscar empréstimos de livros",
        "tags": ["Loans"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de empréstimos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/LoansResponse" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/loans/user/{id}": {
      "get": {
        "summary": "Lista de empréstimo por usuário",
        "tags": ["Loans"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do usuário",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Listagem de empréstimos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoansByUserResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Register": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "John Doe" },
          "email": { "type": "string", "example": "johndoe@example.com" },
          "phone": { "type": "string", "example": "99 99999-9999" },
          "profile": { "type": "string", "example": "ESTUDENT" },
          "situation": { "type": "string", "example": "ACTIVE" },
          "password": { "type": "string", "example": "John@123" }
        }
      },
      "Authenticate": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "example": "johndoe@example.com" },
          "password": { "type": "string", "example": "John@123" }
        }
      },
      "RefreshToken": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "AccessToken": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "d3f1b1a0-1234-4a1b-9c3d-abcdef123456" },
          "name": { "type": "string", "example": "John Doe" },
          "email": { "type": "string", "example": "johndoe@example.com" },
          "phone": { "type": "string", "example": "99 99999-9999" },
          "profile": { "type": "string", "example": "ESTUDENT" },
          "situation": { "type": "string", "example": "ACTIVE" }
        }
      },
      "UserUpdate": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "John Doe" },
          "email": { "type": "string", "example": "johndoe@example.com" },
          "phone": { "type": "string", "example": "99 99999-9999" },
          "profile": { "type": "string", "example": "ESTUDENT" },
          "situation": { "type": "string", "example": "ACTIVE" }
        }
      },
      "Delete": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Usuário deletado com sucesso" }
        }
      },
      "BookRegister": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Livro 1" },
          "author": { "type": "string", "example": "Author" },
          "isbn": { "type": "string", "example": "ISBN 999-99-999-00-5" },
          "publisher": { "type": "string", "example": "Editora example" },
          "category": { "type": "string", "example": "Ficção" },
          "year": { "type": "string", "example": "22/07/2026" },
          "copies": { "type": "integer", "example": 1 },
          "synopsis": { "type": "string", "example": "Um livro de ficção" },
          "coverUrl": {
            "type": "string",
            "example": "http://localhost:3334/uploads/livro1-capa.jpg"
          }
        }
      },
      "Book": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "9df4c581-f647-4d81-8326-29326b3a1e85" },
          "title": { "type": "string", "example": "Livro 1" },
          "author": { "type": "string", "example": "Nome Author" },
          "isbn": { "type": "string", "example": "ISBN 999-99-999-00-9" },
          "publisher": { "type": "string", "example": "Nome editora" },
          "category": { "type": "string", "example": "Ficção" },
          "year": { "type": "string", "example": "2026-07-22T00:00:00.000Z" },
          "copies": { "type": "integer", "example": 5 },
          "synopsis": { "type": "string", "example": "Um livro de ficção" },
          "coverUrl": {
            "type": "string",
            "example": "http://localhost:3334/uploads/livro1-capa.jpg"
          }
        }
      },
      "BookUpdate": {
        "type": "object",
        "properties": {
          "copies": { "type": "integer", "example": 5 },
          "synopsis": { "type": "string", "example": "Um livro de ficção" }
        }
      },
      "BookRecommendations": {
        "type": "object",
        "properties": {
          "baseadoEm": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["A Garota no Trem"]
          },
          "sugestoes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Book" }
          },
          "explicacao": {
            "type": "string",
            "example": "Como você leu A Garota no Trem, que é rico em suspense psicológico, estas obras compartilham elementos de tensão narrativa e desenvolvimento de personagem."
          }
        }
      },
      "UploadImageBook": {
        "type": "object",
        "properties": {
          "coverUrl": {
            "type": "string",
            "example": "http://localhost:3334/uploads/livro1-capa.jpg"
          }
        }
      },
      "DeleteBook": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Livro deletado com sucesso" }
        }
      },
      "LoanRegister": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Empréstimo 1" },
          "userId": { "type": "string", "example": "90njknjkd8-98930390hjdbdb09ko=ejond" },
          "bookId": { "type": "string", "example": "90njknjkd8-98930390hjdbdb09ko=ejond" },
          "loanDate": { "type": "string", "example": "dd/mm/aaaa" },
          "dueDate": { "type": "string", "example": "dd/mm/aaaa" },
          "returnDate": { "type": "string", "example": "dd/mm/aaaa" },
          "status": { "type": "string", "example": "INPROGRESS" }
        }
      },
      "ReturnedLoan": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Empréstimo retornado com sucesso." }
        }
      },
      "LoansResponse": {
        "type": "object",
        "properties": {
          "loans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "example": "c7765ed8-f04c-4268-86c9-bf9d266c63ae" },
                "userId": { "type": "string", "example": "e2d77457-ec01-4fcb-8203-f8aa46d97030" },
                "bookId": { "type": "string", "example": "0c35ee9d-d558-4d3c-b0d0-2a3d68b3ad1a" },
                "loanDate": { "type": "string", "example": "2026-07-30T00:00:00.000Z" },
                "dueDate": { "type": "string", "example": "2026-08-06T00:00:00.000Z" },
                "returnDate": {
                  "type": "string",
                  "nullable": true,
                  "example": "2026-08-03T14:11:56.218Z"
                },
                "status": { "type": "string", "example": "RETURNED" },
                "book": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "example": "0c35ee9d-d558-4d3c-b0d0-2a3d68b3ad1a" },
                    "title": { "type": "string", "example": "A Garota no Trem" },
                    "author": { "type": "string", "example": "Paula Hawkins" },
                    "isbn": { "type": "string", "example": "ISBN 978-789-01-23-4" },
                    "publisher": { "type": "string", "example": "Doubleday" },
                    "category": { "type": "string", "example": "Suspense" },
                    "year": { "type": "string", "example": "2015-01-01T00:00:00.000Z" },
                    "copies": { "type": "integer", "example": 5 },
                    "synopsis": {
                      "type": "string",
                      "example": "Rachel observa diariamente a vida de um casal..."
                    },
                    "coverUrl": { "type": "string", "nullable": true, "example": null },
                    "embedding": {
                      "type": "array",
                      "items": { "type": "number" },
                      "description": "Vetor de embedding semântico do livro"
                    },
                    "embeddingUpdateAt": { "type": "string", "example": "2026-07-30T19:06:47.982Z" }
                  }
                },
                "user": {
                  "type": "object",
                  "properties": {
